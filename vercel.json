{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/newsboard",
      "destination": "https://atelier-continuum.vercel.app/newsboard"
    },
    {
      "source": "/rsvp",
      "destination": "https://atelier-continuum.vercel.app/newsboard/rsvp"
    },
    {
      "source": "/preferences",
      "destination": "https://atelier-continuum.vercel.app/newsboard/preferences"
    },
    {
      "source": "/unsubscribe",
      "destination": "https://atelier-continuum.vercel.app/newsboard/unsubscribe"
    },
    {
      "source": "/evenement",
      "destination": "https://atelier-continuum.vercel.app/newsboard/rsvp"
    },
    {
      "source": "/newsboard/:path*",
      "destination": "https://atelier-continuum.vercel.app/newsboard/:path*"
    },
    {
      "source": "/rsvp/:path*",
      "destination": "https://atelier-continuum.vercel.app/newsboard/rsvp/:path*"
    },
    {
      "source": "/preferences/:path*",
      "destination": "https://atelier-continuum.vercel.app/newsboard/preferences/:path*"
    },
    {
      "source": "/unsubscribe/:path*",
      "destination": "https://atelier-continuum.vercel.app/newsboard/unsubscribe/:path*"
    },
    {
      "source": "/evenement/:path*",
      "destination": "https://atelier-continuum.vercel.app/newsboard/rsvp/:path*"
    }
  ]
}
